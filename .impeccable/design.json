      "css": ".ds-field{display:grid;gap:9px;color:#1c2945;font:400 14px/1.7 Golos,Arial,sans-serif}.ds-field textarea{box-sizing:border-box;width:100%;min-height:122px;padding:16px 18px;border:1px solid #9aaaca;border-radius:16px;background:#f1f4fc;color:#1c2945;font:inherit;resize:vertical;caret-color:#3154d6}.ds-field textarea:focus-visible{outline:3px solid #3154d6;outline-offset:3px}.ds-field textarea::placeholder{color:#52617d}",
      "refersTo": "field-game"
