      "css": ".ds-disclosure{color:#1c2945;font:400 13px/1.6 Golos,Arial,sans-serif}.ds-disclosure summary{display:grid;grid-template-columns:minmax(0,1fr) 18px;gap:12px;align-items:center;cursor:pointer;list-style:none;min-height:44px;padding:12px 14px;border:1px solid #7186bc;border-radius:12px;background:#fff;color:#3154d6;font-weight:550}.ds-disclosure summary::-webkit-details-marker{display:none}.ds-disclosure small{display:block;color:#52617d;font-size:12px;font-weight:400}.ds-disclosure svg{width:18px;height:18px}.ds-disclosure[open] summary{background:#dce5ff}.ds-disclosure[open] svg{transform:rotate(180deg)}.ds-disclosure summary:hover{background:#e8eeff}.ds-disclosure summary:focus-visible{outline:3px solid #3154d6;outline-offset:3px}.ds-disclosure p{margin:12px 0}"
