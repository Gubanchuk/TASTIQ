    {
      "name": "Основное действие",
      "kind": "button",
      "description": "Следующий шаг, min48px; исходный кобальтовый акцент.",
      "html": "<button class=\"ds-button ds-primary\">Дальше</button>",
      "css": ".ds-button{min-height:44px;padding:10px 15px;border:1px solid var(--control-border,#7186bc);border-radius:12px;background:var(--brand-surface,#fff);color:var(--brand-primary,#3154d6);font:550 13px/1.5 Golos,Arial,sans-serif;cursor:pointer;transition:background-color .15s ease-out,border-color .15s ease-out}.ds-button:hover{background:#e8eeff;border-color:#3154d6}.ds-button:focus-visible{outline:3px solid #3154d6;outline-offset:3px}.ds-button:disabled{opacity:.43;cursor:default}.ds-button[aria-pressed=true]{background:#dce5ff;box-shadow:inset 0 0 0 1px #3154d6}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-primary{min-height:48px;min-width:145px;padding:12px 21px;border-radius:13px;background:#3154d6;border-color:#3154d6;color:white}.ds-primary:hover{background:#2544b8;color:white}",
      "refersTo": "button-game-next"
    },
    {
      "name": "Вторичное действие",
      "kind": "button",
      "description": "Явная белая поверхность и кобальтовая граница.",
      "html": "<button class=\"ds-button\">Сохранить</button>",
      "css": ".ds-button{min-height:44px;padding:10px 15px;border:1px solid var(--control-border,#7186bc);border-radius:12px;background:var(--brand-surface,#fff);color:var(--brand-primary,#3154d6);font:550 13px/1.5 Golos,Arial,sans-serif;cursor:pointer;transition:background-color .15s ease-out,border-color .15s ease-out}.ds-button:hover{background:#e8eeff;border-color:#3154d6}.ds-button:focus-visible{outline:3px solid #3154d6;outline-offset:3px}.ds-button:disabled{opacity:.43;cursor:default}.ds-button[aria-pressed=true]{background:#dce5ff;box-shadow:inset 0 0 0 1px #3154d6}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}",
      "refersTo": "button-secondary"
    },
    {
      "name": "Вариант ответа",
      "kind": "button",
      "description": "Выбор в вопросе, самостоятельное pressed-состояние.",
      "html": "<button class=\"ds-button ds-choice\" aria-pressed=\"true\">Погрузиться в историю</button>",
      "css": ".ds-button{min-height:44px;padding:10px 15px;border:1px solid var(--control-border,#7186bc);border-radius:12px;background:var(--brand-surface,#fff);color:var(--brand-primary,#3154d6);font:550 13px/1.5 Golos,Arial,sans-serif;cursor:pointer;transition:background-color .15s ease-out,border-color .15s ease-out}.ds-button:hover{background:#e8eeff;border-color:#3154d6}.ds-button:focus-visible{outline:3px solid #3154d6;outline-offset:3px}.ds-button:disabled{opacity:.43;cursor:default}.ds-button[aria-pressed=true]{background:#dce5ff;box-shadow:inset 0 0 0 1px #3154d6}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-choice{display:flex;align-items:center;text-align:left;min-height:58px;padding:14px 17px;border-radius:14px;font-size:14px;color:#1c2945;width:100%}.ds-choice[aria-pressed=true]{color:#3154d6}",
