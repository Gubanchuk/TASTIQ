# Online picker: server-side only. Copy the needed variables into .env; never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
AI_EFFORT=low
AI_ACCESS=all
AI_SHORTLIST=40
AI_SPARES=0
AI_DISCOVERY_GAMES=0
AI_DISCOVERY_CARTOONS=0

# Discovery is experimental: more candidates did not prove better recommendations.

# AI_ACCESS=off disables paid browser requests during manual/offline testing.
# Optional bounded live evaluation: an EXISTING authorized PaidBudget ledger is required.
# AI_EVAL_BUDGET_DIR=research-vault/taste-quality-strategy-2026-10/eval/quality-round-2
# AI_EVAL_BATCH_ID=interactive-20261031
# AI_EVAL_BATCH_CAP=0.75
# This server owns budget.lock until it exits. Never reset the ledger or remove an active owner's lock.
# Existing tagging/translation scripts under src/pipeline still use their historical Anthropic integration.
