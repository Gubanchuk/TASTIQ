# Online picker: server-side only. Copy the needed variables into .env; never commit a real key.
OPENAI_API_KEY=
# Required on Vercel only for AI replies; the site itself works without a provider key.
OPENAI_MODEL=gpt-6.1-sol
AI_EFFORT=low
AI_ACCESS=all
# No application per-hour/day quota or subscription gate. AI_ACCESS=off is for offline fixtures.
# Site calls have no 45-second app timeout; the Vercel function permits 300 seconds.
AI_SHORTLIST=40
AI_SPARES=0
AI_DISCOVERY_GAMES=0
AI_DISCOVERY_CARTOONS=0

# Discovery is experimental: more candidates did not prove better recommendations.

# AI_ACCESS=off disables paid browser requests during manual/offline testing.
# Optional bounded live evaluation: an EXISTING authorized PaidBudget ledger is required.
# AI_EVAL_BUDGET_DIR=research-vault/taste-quality-strategy-2026-10/eval/quality-round-2
# AI_EVAL_BATCH_ID=interactive-20261031
# AI_EVAL_BATCH_CAP=0.75
# This server owns budget.lock until it exits. Never reset the ledger or remove an active owner's lock.
# Do not copy local AI_EVAL_* paths to Vercel. Production has no durable billing ledger yet.
# On Vercel the diagnostic journal defaults to the OS temp directory and is ephemeral.
# Durable feedback uses a private Supabase RPC. Set both only on the server.
# FEEDBACK_DATABASE_URL=https://your-project.supabase.co
# FEEDBACK_DATABASE_SECRET=your-scoped-tastiq-ingestion-token
# This token only calls the tastiq-feedback ingestion function. Never use a shared app's service-role key here.
# Optional local override: JOURNAL_PATH=data/journal.ndjson
# Existing tagging/translation scripts under src/pipeline still use their historical Anthropic integration.
