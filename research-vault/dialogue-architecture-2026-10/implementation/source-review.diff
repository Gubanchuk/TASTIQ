+++ b/src/server/public/shared/conversation-client.js
@@ -0,0 +1,38 @@
+export const CONVERSATION_KEY='tastiq.conversation.game.v1';
+const clone=value=>value==null?value:structuredClone(value);
+const defaultStorage=()=>{try{return globalThis.localStorage;}catch{return undefined;}};
+const cleanDraft=value=>({text:typeof value?.text==='string'?value.text.slice(0,1600):'',selected:Array.isArray(value?.selected)?value.selected.filter(x=>typeof x==='string').slice(0,20):[],kind:['answer','unknown','indifferent','none'].includes(value?.kind)?value.kind:'answer'});
+
+// Transport, snapshots and drafts are independent of DOM. Reload is always a free resume.
+export function createConversationClient({fetch:request=globalThis.fetch,storage=defaultStorage(),onChange=()=>{},mode='guided',uid=null}={}) {
+ let snapshot=null,drafts={},persistent=Boolean(storage),generation=0,busy=false,error=null,retryBody=null;
+ try {const saved=JSON.parse(storage?.getItem(CONVERSATION_KEY)??'null');if(saved?.version===1){if(saved.snapshot?.state?.version===1&&saved.snapshot?.screen)snapshot=saved.snapshot;if(saved.drafts&&typeof saved.drafts==='object')drafts=saved.drafts;}}catch { /* invalid storage is not trusted */ }
+ const save=()=>{try{if(!storage)throw Error();storage.setItem(CONVERSATION_KEY,JSON.stringify({version:1,snapshot,drafts}));}catch{persistent=false;}};
+ const notify=()=>onChange(api);
+ async function execute(body,{reset=false}={}) {
+  const ticket=++generation,base=clone(body.state);busy=true;error=null;retryBody=clone(body);notify();
+  try {
+   const response=await request('/api/conversation',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
+   const data=await response.json();if(ticket!==generation)return null;
+   if(!data?.state||!data?.screen)throw Error(data?.error||'Не удалось получить ответ. Попробуй ещё раз.');
+   if(!reset&&base&&(data.state.id!==base.id||data.state.revision<base.revision))throw Error('Ответ устарел. Повтори действие.');
+   snapshot=clone(data);if(reset)drafts={};error=data.error||(!response.ok?'Не удалось получить ответ. Попробуй ещё раз.':null);
+   // A server error can preserve an accepted revision. Retry that state explicitly.
+   if(data.error&&data.retryable)retryBody={state:clone(data.state),action:{type:'retry'},...(uid?{uid}:{})};
+   else if(!error)retryBody=null;
+   save();return clone(data);
+  } catch(cause) {if(ticket===generation)error=cause?.message||'Нет связи с сервером. Ответ сохранён. Попробуй ещё раз.';return null;}
+  finally {if(ticket===generation){busy=false;notify();}}
+ }
+ const api={
+  get state(){return clone(snapshot?.state??null);},get screen(){return clone(snapshot?.screen??null);},
+  get snapshot(){return clone(snapshot);},get busy(){return busy;},get error(){return error;},get persistent(){return persistent;},
+  draft(key){return cleanDraft(drafts[key]);},
+  saveDraft(key,value){drafts[key]=cleanDraft(value);save();},
+  start(){return execute({...(snapshot?{state:clone(snapshot.state)}:{mode:mode==='free'?'free':'guided'}),...(uid?{uid}:{})});},
+  send(action){return execute({...(snapshot?{state:clone(snapshot.state)}:{}),action:clone(action),...(uid?{uid}:{})},{reset:action.type==='restart'});},
+  retry(){return retryBody?execute(clone(retryBody),{reset:retryBody.action?.type==='restart'}):api.send({type:'retry'});},
+  invalidate(){generation++;busy=false;error=null;notify();},
+ };
+ return api;
+}
