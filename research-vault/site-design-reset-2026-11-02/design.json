      "kind": "button",
      "refersTo": "conversation-primary",
      "description": "Кнопка отдельного невыбранного кандидата; акценты не объединяются в продуктовую палитру.",
      "html": "<span class=\"ds-conversation\"><button class=\"ds-button ds-primary\">Беру на вечер</button></span>",
      "css": ".ds-conversation{--ink:#2b2b2a;--muted:#6b655f;--accent:#b84025;--surface:#fbf4ec;--line:#d9cec4;--ease:cubic-bezier(.16,1,.3,1);font-family:Golos,Arial,sans-serif;color:var(--ink)} .ds-button{display:inline-flex;align-items:center;justify-content:center;gap:9px;cursor:pointer;font-family:inherit;color:inherit}.ds-button{border:1px solid var(--line);border-radius:6px;background:transparent;padding:11px 16px;min-height:44px;font-size:13px;font-weight:550;line-height:1.4;transition:background .18s var(--ease),border-color .18s var(--ease)}.ds-button:hover{background:#00000008;border-color:#8d9592}.ds-button.ds-primary{background:var(--accent);color:#fff;border-color:var(--accent)}.ds-button.ds-primary:hover:not(:disabled){filter:brightness(.92)}.ds-button:focus-visible,.ds-field:focus-visible,.ds-choice:focus-visible,.ds-filter:focus-visible,.ds-select:focus-visible{outline:3px solid #257eaa;outline-offset:4px}.ds-button:disabled{opacity:.48;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}"
    },
