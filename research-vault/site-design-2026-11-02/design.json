      "css": ".ds-option{display:inline-flex;align-items:center;justify-content:space-between;gap:9px;min-height:72px;padding:20px 17px;background:#e3eacf;color:var(--ink,#19382f);border:1px solid #708b55;border-radius:10px;font:14px/1.5 Onest,Arial,sans-serif;text-align:left;cursor:pointer;transition:background .18s cubic-bezier(.16,1,.3,1),border-color .18s cubic-bezier(.16,1,.3,1)}.ds-mark{display:grid;place-items:center;flex:none;width:24px;height:24px;border:1px solid #3d603a;border-radius:50%;background:#3d603a;color:#f6f5eb}.ds-mark svg{width:14px;height:14px}.ds-option:hover{border-color:#809c69}.ds-option:focus-visible{outline:3px solid #b4ca60;outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-option{transition:none}}"
