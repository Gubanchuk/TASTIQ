    {
      "name": "Collection / Постоянная навигация",
      "kind": "nav",
      "description": "Тёмная desktop-навигация невыбранной Медиатеки.",
      "html": "<nav class=\"ds-rail\" aria-label=\"Разделы макета\"><button aria-current=\"page\">Игры</button><button>Фильмы</button><button>Сериалы</button><button>Мультфильмы</button><button class=\"ds-library\">Библиотека</button></nav>",
      "css": ".ds-rail{display:flex;flex-direction:column;gap:7px;width:164px;padding:23px;background:#183633;color:#eaf1e4;font-family:Onest,Arial,sans-serif}.ds-rail button{display:inline-flex;align-items:center;justify-content:flex-start;gap:13px;padding:13px 11px;min-height:45px;border:0;border-radius:7px;background:transparent;color:#d3e0d2;font:12px Onest,Arial,sans-serif;text-align:left;cursor:pointer}.ds-rail button[aria-current=page]{color:#193b30;background:#dcebb7}.ds-rail button:hover{background:#34544a;color:#fff}.ds-rail button:focus-visible{outline:3px solid #b4ca60;outline-offset:4px}.ds-rail .ds-library{margin-top:30px;border-top:1px solid #52705f;padding-top:16px}"
